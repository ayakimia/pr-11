program AverageOnMainDiagonal; // Назва програми
var // Оголошення змінних
  a: array[1..100, 1..100] of integer; // Квадратна матриця
  n, i, j, s: integer; // Розмір, індекси та сума
begin // Початок програми
  write('Розмір матриці (1..100): '); // Запит розміру
  readln(n); // Зчитування розміру
  if (n < 1) or (n > 100) then // Перевірка допустимих меж
  begin // Початок блоку перевірки
    writeln('Неправильний розмір'); // Повідомлення про помилку
    exit; // Вихід із програми
  end; // Кінець блоку перевірки
  writeln('Введіть елементи матриці:'); // Запит елементів
  for i := 1 to n do // Перебір рядків
    for j := 1 to n do // Перебір стовпців
      read(a[i,j]); // Зчитування елемента
  s := 0; // Початкова сума
  for i := 1 to n do // Перебір головної діагоналі
    s := s + a[i,i]; // Додавання елемента діагоналі
  writeln('Середнє арифметичне: ', s / n:0:2); // Виведення середнього
end. // Кінець програми
